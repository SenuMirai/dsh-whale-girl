};

/**
 * 待补淶待补У待补·待补ȷ待补 assets 待补Ŀ¼待补ڣ待补·待补Խ待补
 * @returns 待补淶待补ľ待补ļ待补·待补Ƿ待补Խ待补ʱ待补 undefined
 */
function resolveAsset(root: string, rel: string): string | undefined {
  if (rel.length === 0) return undefined;
  const candidate = normalize(join(root, rel));
  const rootWithSep = root.endsWith(sep) ? root : root + sep;
  if (candidate !== root && !candidate.startsWith(rootWithSep)) return undefined;
  return candidate;
}

/** 待补 root 待补½待补ȷ待补ʵ待补ڣ待补Ƿ待补Խ待补򲻴待补ʱ待补 undefined */
function resolveExisting(root: string, rel: string): string | undefined {
  const candidate = resolveAsset(root, rel);
  return candidate && existsSync(candidate) ? candidate : undefined;
}

/**
 * 待补ʽ待补һ待补ļ待补 Content-Type / 待补 / 待补ͷ待补
 *
 * Content-Length 待补ȡ待补**待补ڶ待补Ǹ待补 fd**待补open 待补¼待补 fstat待补 stat 待补û待补
 * $DSH_HOME/dsh-whale-girl/main-animation/webm/ 待补ƻ待补ͬ待补ز待补ʱ待补stat 待补ʼ待补֮待补ļ待补ᱻ待补ض待补/
 * 待补д待补һ待补ʵ待补ֽ待补ĳ待补ȣ待补Ӧ待补**待补Զ待补Ҳ待补**待补Ϊ stalled待补
 * 待补Ƶ loadeddata 待补 error待补 issue #62 待补ֳ待补"待补ݶϹ待补"待补һ待补ֳ待补ͬһ待补 fd 待补
 * fstat 待补õ待补Ĵ待补С待补ֽ待补Ȼһ待补¡待补
 */
function sendFile(res: ServerResponse, file: string, contentType: string): void {
  const stream = createReadStream(file);
  stream.once('open', (fd) => {
    if (res.destroyed || res.writableEnded) {
      stream.destroy(); // 待补ͻ待补ڿ待补ǰ待补ͷ待补
      return;
    }
    try {
      res.writeHead(200, {
        'content-type': contentType,
        'content-length': fstatSync(fd).size,
        'cache-control': 'public, max-age=3600',
      });
    } catch {
      // 待补 fstat 待补ò待补ͷ待补 Node 待补 chunked 待补β待补Ȼһ待补£待补ֻ待补û待补
      res.writeHead(200, { 'content-type': contentType, 'cache-control': 'public, max-age=3600' });
    }
    stream.pipe(res);
  });
  // 待补ʧ待补ܣ待补ļ待补ɾ/Ȩ待补/待补ռ待补ã待补ֱ待补Ӷ待补ÿͻ待补̿待补ʧ待补ܣ待补޵ȴ待补
  stream.on('error', () => res.destroy());
  // 待补ͻ待补ǰ待补Ͽ待补ж待补ʱ待补Ƶ待补 ͣ待补ļ待补
  res.on('close', () => stream.destroy());
}

// 待补õĶ待补ȡ/У待补/待补ϲ待补/待补ȫ待补 ./config待补readAllConfig / saveUserConfig待补host 待补԰待补ʵ待补֣待补
// 待补 import src/shared 待补 DSH 待补ļ待补Լ待补ļ待补ٱ待补κ待补߼待补ֻ待补ѳ待补Ʒ待补ֵ待补

/** 待补ó待补Ƿ待补ģʽ待补Electron ͸待补 */
const isDesktopVisible = (display: unknown): boolean => display === 'desktop' || display === 'both';

/** 待补 JSON 待补Ӧ待补headers 待补ѡ待补 no-cache 待补 */
function sendJson(res: ServerResponse, status: number, obj: unknown, headers: Record<string, string> = {}): void {
  const body = JSON.stringify(obj);
  res.writeHead(status, {
    'content-type': 'application/json; charset=utf-8',
    'content-length': Buffer.byteLength(body),
    ...headers,
  });
  res.end(body);
}

/** 待补ʹ待补ı待补Ӧ待补ز待补 404/400 待补ʽ待补İ待补 */
function sendText(res: ServerResponse, status: number, body: string): void {
  res.writeHead(status, { 'content-type': 'text/plain; charset=utf-8' });
  res.end(body);
}

/**
 * 待补Ͷ待补Ӧ待补ϳɵ待补 MP3待补
 *
 * ֻ待补 HTTP待补 Helper 待补 bridge 待补ܵ待补 JSON 待补Э待补飬待补˶待补Ƶ待补
 * 待补洰待补 `/voice/tts` 待补 HTTP 待补˵㣨待补뱾待补 127.0.0.1 ͬԴ待补 bridge待补
 */
function sendBuffer(res: ServerResponse, status: number, body: Uint8Array, contentType: string): void {
  const buf = Buffer.from(body.buffer, body.byteOffset, body.byteLength);
  res.writeHead(status, {
    'content-type': contentType,
    'content-length': buf.length,
    // ͬһ待补ı待补ϳɽ待补ɻ待补棬待补һ待补Եģ待补ô待补/待补̫待补
    'cache-control': 'no-store',
  });
  res.end(buf);
}

/** 待补ҵ待补·待补ɵ待补Ӧ待补WebServer ע待补 Helper 待补ܵ待补õ待补ͬһ待补Լ待补ѷ待补̣待补 */
type RouteResult =
  | { kind: 'json'; status: number; obj: unknown; headers?: Record<string, string> }
  | { kind: 'text'; status: number; body: string }
  | { kind: 'file'; file: string; contentType: string }
  | { kind: 'buffer'; status: number; body: Uint8Array; contentType: string };

/** 待补ռ待补壨待补ı待补 */
function readBody(req: IncomingMessage): Promise<string> {
  return new Promise((resolve2, reject) => {
    const chunks: Buffer[] = [];
    req.on('data', (c: Buffer) => chunks.push(c));
    req.on('end', () => resolve2(Buffer.concat(chunks).toString('utf8')));
    req.on('error', reject);
  });
}

